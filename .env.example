# =============================================================================
# AgentFxTrading — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# cTrader Remote MCP (get from cTrader Web → Settings → Remote MCP)
CTRADER_MCP_URL=https://mcp.ctrader.com/trading/mcp
CTRADER_MCP_TOKEN=your_bearer_token_here

# Trading (multi-symbol support)
SYMBOLS=XAUUSD,EURUSD,GBPUSD
TIMEFRAME=H1
LOOKBACK_BARS=100

# TMS Indicator Parameters (from TMSBot.cs / tms-strategy.md)
TMS_RSI_PERIOD=6
TMS_RED_PERIOD=6
TMS_RED_METHOD=EMA
TMS_STOCH_K=6
TMS_STOCH_D=6
TMS_STOCH_SLOWING=4
TMS_STOCH_MODE=KAboveD
TMS_MAX_BARS_AFTER_CROSS=5
TMS_MIN_ANGLE_DELTA=0.0
TMS_FLAT_THRESHOLD=0.01

# ORB (Opening Range Breakout) - runs on lower timeframe (M15/M5)
ORB_ENABLED=true
ORB_TIMEFRAME=M15
ORB_DEFAULT_SESSION=london
ORB_DEFAULT_HOUR=7
ORB_DEFAULT_MINUTE=0
ORB_CANDLES=1
ORB_MIN_WIDTH=0.0
ORB_BUFFER=0.0
ORB_MAX_BARS=5

# Per-symbol ORB sessions (optional)
# Format: SYMBOL:session:hour,SYMBOL:session:hour
# Example: USDJPY:tokyo:0,USDCAD:newyork:12
ORB_SYMBOL_SESSIONS=

# Risk Management
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MIN_RR_RATIO=1.5

# Volatility & spread filters (XAUUSD liquidity sweep protection)
MAX_SPREAD_PIPS=5.0
MIN_SL_ATR_MULTIPLE=1.5
MAX_ATR_PERCENTILE=90.0

# News filter
NEWS_FILTER_ENABLED=true
NEWS_BUFFER_MINUTES=30

# Symbol-specific risk overrides (optional)
# Format: SYMBOL:risk_pct:max_sl_pips
# Example: XAUUSD:0.5:50,EURUSD:1.0:30
SYMBOL_RISK_OVERRIDES=

# Portfolio Risk (multi-pair trading)
MAX_PORTFOLIO_HEAT_PCT=5.0
MAX_MARGIN_USAGE_PCT=50.0
MAX_SAME_CURRENCY_EXPOSURE=2
MAX_CORRELATED_POSITIONS=2
CORRELATION_THRESHOLD=0.7

# LLM Provider (qwen | deepseek | openai | anthropic | gemini)
LLM_PROVIDER=qwen
LLM_API_KEY=your_api_key
LLM_MODEL=qwen-max
# LLM_BASE_URL (auto-set for qwen/deepseek, override if needed)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# Cycle (minutes between analysis runs in continuous mode)
CYCLE_MINUTES=240

# Trading sessions (only trade during these hours, UTC)
TRADING_SESSIONS=london,newyork
LONDON_START=7
LONDON_END=16
NEWYORK_START=12
NEWYORK_END=21

# Application
LOG_LEVEL=INFO
